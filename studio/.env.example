# Copy to .env and fill in. .env is gitignored - never commit real values.

# ---------------------------------------------------------------------------
# Sign-in providers (optional in development)
#
# Without these the sign-in page offers the development login instead, which the
# server refuses once NODE_ENV=production.
#
# GitHub:  github.com/settings/developers -> OAuth Apps -> New OAuth App
#   Homepage URL:  http://localhost:5173
#   Callback URL:  http://localhost:4000/api/auth/github/callback
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: console.cloud.google.com -> APIs & Services -> Credentials
#   Authorised redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Where the browser reaches this API. Empty = same origin.
# The front end defaults to http://localhost:4000 in development.
VITE_API_BASE=

# Origins allowed to call the API, comma separated. Unset allows any, which is
# fine locally but should be set once deployed.
CORS_ORIGIN=

# Public origins, used to build OAuth redirects when behind a proxy.
PUBLIC_API_ORIGIN=
PUBLIC_APP_ORIGIN=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DATABASE_PATH=server/data/studio.db
RECORDINGS_PATH=server/recordings

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional TURN relay for guests behind strict NAT (STUN-only otherwise)
TURN_URL=
TURN_USER=
TURN_PASS=
